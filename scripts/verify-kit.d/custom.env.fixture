VERIFY_KIT_FIRST=first-line
# verify-kit の setup-environment 検査用 custom.env（UTF-8・LF・BOM なし。値はすべてダミー）。
# 1 行目を KEY=VALUE にしているのは、実行時に作る BOM + CRLF 版で「先頭行の BOM 除去」を検査するため。
VERIFY_KIT_PLAIN=hello
VERIFY_KIT_JP=日本語の値
VERIFY_KIT_SPACED =  spaced value
  VERIFY_KIT_INDENTED=indented
VERIFY_KIT_EQ=a=b=c
VERIFY_KIT_EMPTY=
VERIFY_KIT_PROXY_URL=http://proxy.example.invalid:8080
VERIFY_KIT_PLAIN=last-wins
CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD=0
  # 字下げしたコメント
noequals-line
# 分類A（機微）: 既知キーの小文字・混在、接尾辞、URL 埋め込みの資格情報
anthropic_api_key=dummy-not-a-secret
Anthropic_Auth_Token=dummy-not-a-secret
aws_access_key_id=dummy-not-a-secret
Aws_Session_Token=dummy-not-a-secret
VERIFY_KIT_API_KEY=dummy-not-a-secret
verify_kit_db_password=dummy-not-a-secret
VERIFY_KIT_SECRET_MODE=dummy-not-a-secret
VERIFY_KIT_PASSPHRASE=dummy-not-a-secret
otel_exporter_otlp_logs_headers=dummy-not-a-secret
VERIFY_KIT_AUTH_URL=https://verify-kit:dummy-not-a-secret@proxy.example.invalid:8080
# 分類A（機微）: 接尾辞 *_TOKEN / *_ACCESS_KEY / *_PRIVATE_KEY と、値のどこにあっても検出する URL 埋め込みの資格情報
#   （コロン無しの userinfo・引用符付き・scheme が値の先頭でない形）
VERIFY_KIT_GH_TOKEN=dummy-not-a-secret
verify_kit_hf_token=dummy-not-a-secret
VERIFY_KIT_PERSONAL_ACCESS_TOKEN=dummy-not-a-secret
VERIFY_KIT_STORAGE_ACCESS_KEY=dummy-not-a-secret
VERIFY_KIT_PRIVATE_KEY=dummy-not-a-secret
VERIFY_KIT_TOKEN_URL=https://dummy-not-a-secret@proxy.example.invalid
VERIFY_KIT_QUOTED_URL="http://verify-kit:dummy-not-a-secret@proxy.example.invalid"
VERIFY_KIT_JDBC_URL=jdbc:postgresql://verify-kit:dummy-not-a-secret@db.example.invalid/x
# 分類A ではない（読み込まれること）: _TOKENS で終わる名前・鍵ファイルのパス（*_CREDENTIALS）・userinfo ではない @
VERIFY_KIT_MAX_TOKENS=32000
VERIFY_KIT_APPLICATION_CREDENTIALS=verify-kit-dummy-key.json
VERIFY_KIT_AT_PATH_URL=https://example.invalid/@user
VERIFY_KIT_AT_QUERY_URL=https://example.invalid?x=a@b
# 環境変数名として不正（キー名が空の行を含む）
BAD NAME=x
1BAD=x
VERIFY-KIT-DASH=x
=novalue
# ランチャーの内部変数名（警告して読み飛ばす）。bash 版で export が効くと、以後の行の分類A 完全一致判定が外れ
# （接尾辞では拾えない AWS_ACCESS_KEY_ID が通る）、IFS はランチャー本体の単語分割まで変える
_SENSITIVE_KEYS=x
IFS=,
_ROOT_DIR=/verify-kit-dummy
AWS_ACCESS_KEY_ID=dummy-not-a-secret
# 分類A（機微）: 完全一致の ANTHROPIC_CUSTOM_HEADERS・接尾辞と同じ語の名前全体・SECRET_*・*_PASS / *_PASSWD / *_PWD / *_CONNECTION_STRING
ANTHROPIC_CUSTOM_HEADERS=X-Verify-Kit: dummy-not-a-secret
API_KEY=dummy-not-a-secret
Token=dummy-not-a-secret
SECRET_VERIFY_KIT=dummy-not-a-secret
VERIFY_KIT_DB_PASS=dummy-not-a-secret
verify_kit_x_pwd=dummy-not-a-secret
VERIFY_KIT_X_PASSWD=dummy-not-a-secret
VERIFY_KIT_X_CONNECTION_STRING=dummy-not-a-secret
# 分類A ではない（読み込まれること）: _PASS で終わらない名前・接尾辞ではない PASSWORD・内部変数名ではない _ 始まり
VERIFY_KIT_BYPASS=1
VERIFY_KIT_PASSWORD_FILE=verify-kit-dummy-password.txt
_VERIFY_KIT_UNDERSCORE=ok
# 分類A（機微）: special scheme（http / https / ws / wss / ftp。大文字小文字を区別しない）の直後の // が抜けた URL 埋め込みの
#   資格情報（WHATWG URL 規格が // の欠落と \ を補うため、claude は認証付き URL として使う）。引用符付きも対象
VERIFY_KIT_NOSLASH_URL=http:verify-kit:dummy-not-a-secret@proxy.example.invalid:8080
VERIFY_KIT_BACKSLASH_URL=HTTPS:\verify-kit:dummy-not-a-secret@proxy.example.invalid
VERIFY_KIT_WS_URL=ws:dummy-not-a-secret@ws.example.invalid
VERIFY_KIT_QUOTED_NOSLASH_URL="http:verify-kit:dummy-not-a-secret@proxy.example.invalid"
# 分類A ではない（読み込まれること）: special scheme 以外（mailto / socks5）・@ の無い形・語の途中のスキーム名（xhttp）
VERIFY_KIT_MAILTO=mailto:user@example.invalid
VERIFY_KIT_NOAT_URL=http:example.invalid
VERIFY_KIT_XHTTP=xhttp:verify-kit@example.invalid
VERIFY_KIT_SOCKS5=socks5:verify-kit@example.invalid
