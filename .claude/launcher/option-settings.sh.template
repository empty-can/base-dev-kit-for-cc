# =============================================================================
# option-settings.sh.template  ―  claude 起動時オプションの雛型（分類D・bash 版）
# =============================================================================
# 使い方:
#   1) .claude/ 直下へ「option-settings.sh」としてコピーする（.gitignore 済みの個人実体）。
#      launcher/ に置いたものは読み込まれない（ランチャーが警告する）。
#   2) 使う行の先頭の "# " を外して値を設定する。値を取らないフラグ（--verbose 等）は "true" にする。
#   3) start_claude_code.sh がこの OPTS を読み、claude の起動オプションを組み立てる。
# 書式:
#   - 同じキーは 1 回しか書けない。複数の値を渡すフラグ（--add-dir 等）の 2 個目以降は起動時引数で渡す。
# 背景・既定値の決まり方・載せていないオプション・注意の詳細は、テンプレートと同じフォルダ（launcher/）の README.md（以下 README）。
# =============================================================================

declare -A OPTS=(
  # ===== モデル =====
  # 使用モデル。エイリアス（opus / sonnet / haiku / fable / best / opusplan。1M コンテキストは opus[1m] / sonnet[1m]）か
  #   フルモデル名（例: claude-opus-5-5 / claude-sonnet-5-5 / claude-haiku-5-5 / claude-fable-5-1）。
  #   未指定時は ANTHROPIC_MODEL・settings の model・組織の既定などの順で決まる（README 付録 B）。版を固定するならフルモデル名
  # [--model]="opus"
  # 過負荷・利用不可時のフォールバック先。カンマ区切りで順に試す（最大 3 モデル。切り替えはそのターンだけ）
  # [--fallback-model]="sonnet,haiku"
  # Advisor（要所で相談する上位モデル。このセッションだけ advisorModel 設定を上書き。
  #   主モデルが非対応・指定モデルが advisor 不可だと起動時にエラー。サードパーティプロバイダでは使えない）
  # [--advisor]="fable"

  # ===== 設定ソース・作業ディレクトリ =====
  # 追加の作業ディレクトリ（1 値だけ。2 個目以降は起動時引数で渡す）。UNC などのネットワークパスは不可（v2.1.257 以降）。
  #   Windows ではドライブ文字に割り当てて指定する（README 付録 B）
  # [--add-dir]="<参照したいリポジトリのパス>"
  # 追加で読む settings（ファイルパス または インライン JSON 文字列。同じキーはこのセッションだけ
  #   settings.json の値を上書きする。ファイルは 2 MiB 以下の通常ファイル）
  # [--settings]="./.claude/settings.extra.json"
  # 読み込む設定ソースの限定（user / project / local のカンマ区切り。例: project,user）。
  #   ⚠ project を外すとキットの保護（permissions.deny・hooks）が効かない（README 付録 B）
  # [--setting-sources]="project,user"

  # ===== MCP =====
  # 追加の MCP 設定ファイル
  # [--mcp-config]="./.mcp.extra.json"
  # 指定した --mcp-config のみ使用し他の MCP 設定を無視（値不要フラグ）
  # [--strict-mcp-config]="true"

  # ===== 権限 =====
  # 権限モード（default〔= manual〕/ acceptEdits / plan / auto / dontAsk〔確認が要る操作をすべて拒否〕）。
  #   未指定時は対話起動で auto（使えなければ Manual）、-p は default（README 付録 B）。"default" で Manual に固定する。
  #   ⚠ 固定すると再開時に終了時のモードが復元されない（README 付録 B）。bypassPermissions は書かない（下の「非推奨・破壊的」節）
  # [--permission-mode]="default"

  # ===== エージェント / プラグイン / システムプロンプト =====
  # 追加サブエージェント定義（インライン JSON）。ファイルパスは --print 併用時だけ（v2.1.281 以降。対話起動ではエラー）
  # [--agents]='{"reviewer":{"description":"Reviews code","prompt":"You are a code reviewer"}}'
  # 単一エージェントの指定
  # [--agent]="my-agent"
  # システムプロンプトへ追記（ファイル指定）
  # [--append-system-prompt-file]="./prompt-append.txt"
  # システムプロンプトへ追記（文字列指定）。ファイル指定と併用すると、ファイルの内容が先に入る（併用は v2.1.283 以降）
  # [--append-system-prompt]="追加の指示"
  # 追記したシステムプロンプトを最初のリクエストで記録し、--continue / --resume 後も圧縮まで使い続けるか（on〔既定〕/ off）。
  #   off にすると毎回作り直す（書き換えを再開した会話にも効かせたいとき）
  # [--system-prompt-snapshot]="off"
  # ローカルのプラグイン（ディレクトリ / .zip、またはプラグインを並べたフォルダ）をこのセッションだけ読み込む
  # [--plugin-dir]="./my-plugins"
  # URL からプラグインの .zip を取得し、このセッションだけ読み込む（空白区切りで複数 URL 可）
  # [--plugin-url]="https://example.com/plugin.zip"
  # 使えるビルトインツールの限定（"" で全部無効、"default" で既定セット、または "Bash,Edit,Read" のような列挙）。
  #   MCP ツールには効かない。列挙に ToolSearch を含めないと、MCP ツールは最初から全部読み込まれる（README 付録 B）
  # [--tools]="Read,Grep,Edit"
  # このセッションの skill / スラッシュコマンドをすべて無効にする（キットの skill も使えなくなる・値不要フラグ）
  # [--disable-slash-commands]="true"

  # ===== セッション継続 =====
  # 直近のセッションを継続（値不要フラグ。終了済みの background セッションも対象。-p / SDK のセッションは飛ばす）
  # [--continue]="true"
  # セッションを指定して再開（セッション ID / --name で付けた名前 / transcript .jsonl の絶対パス。"true"〔値なし〕なら picker）
  # [--resume]="<session-id または名前>"
  # セッション ID を明示指定（UUID）
  # [--session-id]="<uuid>"
  # 再開時に新しいセッション ID へ分岐（--resume / --continue と併用・値不要フラグ）
  # [--fork-session]="true"
  # 指定 PR に紐づくセッションを選ぶ picker を開く（PR 番号 / GitHub・GHE の PR URL / GitLab MR URL /
  #   Bitbucket PR URL。紐づけは Claude が PR を作ったときに自動で行われる）
  # [--from-pr]="123"
  # セッションに表示名を付ける（/resume の一覧とターミナルタイトルに出る。--resume <名前> で再開できる）
  # [--name]="my-feature-work"

  # ===== worktree / エージェントチーム / API =====
  # 隔離した git worktree（<repo>/.claude/worktrees/<名前>）で起動する。値は worktree 名・"#<PR 番号>"・
  #   GitHub PR URL・GitLab MR URL（v2.1.233 以降）。"true"（値なし）なら名前を自動生成。既存の名前なら開き直す。
  #   ⚠ 変更も新しいコミットも無い worktree は、名前の無いセッションだと終了時に確認なしでブランチごと削除される（README 付録 B）
  # [--worktree]="feature-auth"
  # worktree 用の tmux セッションを作る（--worktree が必要。iTerm2 ではネイティブペイン・値不要フラグ）
  # [--tmux]="true"
  # エージェントチームのチームメイトの表示方式（in-process〔既定〕/ auto / tmux / iterm2。tmux / iterm2 は分割ペイン）。
  #   実験的機能: CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1 が無いとチーム自体が作られない（README 付録 B）
  # [--teammate-mode]="in-process"
  # API リクエストに付けるベータヘッダ（API キー利用者のみ。複数あるときは起動時引数で空白区切り）
  # [--betas]="interleaved-thinking"

  # ===== IDE / 表示 / デバッグ =====
  # IDE 連携で起動（値不要フラグ）
  # [--ide]="true"
  # 詳細ログ（ターン単位の全出力。このセッションだけ viewMode 設定を上書き・値不要フラグ）
  # [--verbose]="true"
  # デバッグ出力（値不要フラグ）。カテゴリで絞るときは「=」形をキーに書く（値として分けると絞り込みが効かない）
  #   例: [--debug=mcp,startup]="true"  /  除外: [--debug=!mcp]="true"
  # [--debug]="true"
  # デバッグログを指定したファイルへ書く（デバッグモードも有効になる。環境変数 CLAUDE_CODE_DEBUG_LOGS_DIR より優先）。
  #   起動時の警告を読むのに使う（README 付録 B）。⚠ 誤コミットを防ぐため、リポジトリの外のパスにする
  # [--debug-file]="<デバッグログのファイルパス>"

  # ===== 思考 / コンテキスト =====
  # 推論の努力度（low / medium / high / xhigh / max、または ultracode＝xhigh＋動的ワークフロー）。使える段階はモデルによる。
  #   既定: Opus 5.5 / Sonnet 5.5 / Haiku 5.5 は medium、Opus 4.7 は xhigh、他は high。指定はこのセッションだけ。
  #   ⚠ 環境変数 CLAUDE_CODE_EFFORT_LEVEL があるとそちらが優先され、このフラグは効かない（README §4）
  # [--effort]="high"
  # 自動圧縮のウィンドウ（このセッションだけ）。auto（モデルの既定）かトークン数: 200000 / 500k / 1M / 100〜1000（千単位）。
  #   範囲は 100K〜1M（v2.1.221 以降）。⚠ 環境変数 CLAUDE_CODE_AUTO_COMPACT_WINDOW があるとそちらが優先（README §2-4）
  # [--autocompact]="500k"

  # ===== 非対話 / print モード（ヘッドレス実行向け・通常の対話起動では不要）=====
  # 標準出力へ一括応答して終了（値不要フラグ）
  # [--print]="true"
  # 出力フォーマット（text / json / stream-json）
  # [--output-format]="text"
  # 入力フォーマット（text / stream-json）
  # [--input-format]="text"
  # 部分メッセージ（ストリーミングの途中経過）も出力に含める（--print かつ --output-format stream-json のとき・値不要フラグ）
  # [--include-partial-messages]="true"
  # API 利用額の上限（USD・--print 時のみ）。クライアント側の概算で判定するため、上限を超えることもある
  # [--max-budget-usd]="5"
  # エージェントのターン数の上限（--print 時のみ。既定は無制限。上限に達するとエラー終了）
  # [--max-turns]="50"
  # 権限確認を委譲する MCP ツール（--print 時のみ。対話起動では効かない）。mcp__<サーバー>__<ツール> の完全名で、
  #   その実行で読み込む MCP サーバー（--mcp-config 等）のツールを指定する
  # [--permission-prompt-tool]="mcp__approval__prompt"
  # 権限確認に誰が答えるか（--print 時のみ。host〔既定〕/ none。none は確認が要る操作を自動で拒否する・v2.1.259 以降）
  # [--permission-prompts]="none"
  # サブエージェントのシステムプロンプトへ追記（--print 時のみ。文字列版とファイル版は併用不可・v2.1.261 以降）
  # [--append-subagent-system-prompt-file]="./subagent-rules.txt"

  # ===== ⚠⚠ 非推奨・破壊的（内容を理解した上でのみ有効化）⚠⚠ =====
  # 権限確認をすべてスキップする。誤操作・情報漏えいのリスクを理解した上で（値不要フラグ）。
  #   --permission-mode bypassPermissions と同等。そちらには書かない（キーが重複する。README 付録 B）
  # [--dangerously-skip-permissions]="true"
  # bypassPermissions を Shift+Tab の切り替え候補に加える（起動時は別のモード・値不要フラグ）。
  #   ⚠ plan モードでも確認なしで実行されうる。上のフラグと同じ扱いにする（README 付録 B）
  # [--allow-dangerously-skip-permissions]="true"
)
