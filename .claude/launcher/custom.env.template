# =============================================================================
# custom.env.template  ―  利用者が値を設定する環境変数の雛型（分類D）
# =============================================================================
# 使い方: 1) 一つ上の .claude/ 直下へ「custom.env」としてコピーする（.gitignore 済みの個人実体）。
#            正: .claude/custom.env    誤: .claude/launcher/custom.env（警告して読み込まない）
#         2) 使う行の先頭の "# " を外して値を設定する。不要な行はコメントのまま。
#         3) 変更は claude の再起動だけで反映される。
# 書式（1 行 1 件の KEY=VALUE のみ。空行と行頭 "#" の行は無視される）:
#   - 値をクォートで囲まない（引用符も値に含まれる）。"export " を前置しない。
#   - 行末に "# コメント" を書かない（"#" 以降も値に含まれる）。$VAR / %VAR% は展開されない。
#   - UTF-8 で保存する（ANSI / CP932 で保存すると非 ASCII の値が化ける）。
# ⛔ API キー・トークン・パスワード・組織外秘の URL などの機微情報は書かない。OS の環境変数で設定する
#    （既知のキー・資格情報らしい名前・資格情報入りの URL は、書くと警告してその行を読み込まない。README §3-2）。
# 書ける値・書式の細則（書けない名前・空値・on/off）・機微と判定される名前・優先順位・background セッションへの届き方の詳細は、テンプレートと同じフォルダ（launcher/）の README.md（以下 README）。
# =============================================================================

# --- モデル関連（起動オプション --model と役割が重なる。原則 option-settings 側で指定する。README §4）---
# 新規セッションの「既定」モデル（v2.1.236 以降）。/model で保存した選択があればそちらが優先される。
# default / inherit / opusplan / haiku を指定した場合は無視される。
# ANTHROPIC_DEFAULT_MODEL=opus
# 起動のたびに「強制」するモデル。/model で保存した選択より優先され、次回起動でもこの値に戻る。
# ANTHROPIC_MODEL=claude-opus-5-5
# バックグラウンド処理（セッション名の生成等）と haiku エイリアスに使うモデル。
# 旧名 ANTHROPIC_SMALL_FAST_MODEL は非推奨（DEPRECATED）。こちらを使うこと。
# ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-5-5
# サブエージェントの「既定」モデル。agent 定義の model: と呼び出し時の指定が優先される（README §3-4）。
# CLAUDE_CODE_SUBAGENT_MODEL=sonnet
# 定義側の指定も無視して全サブエージェントへ強制したい場合のみ併用する（v2.1.257 以降）。
# CLAUDE_CODE_SUBAGENT_MODEL_FORCE=1

# --- 推論の深さ（effort）---
# 思考の量（low / medium / high / xhigh / max / auto〔モデル既定に戻す〕。現行モデルの仕組みは README §3-4）。
# ⚠ --effort・/effort より優先され、起動中に変えられなくなる。都度変えるなら設定せず /effort を使う（README §4）
# CLAUDE_CODE_EFFORT_LEVEL=high
# 旧方式の固定思考予算。現行モデルでは正の値が無視される（効く条件は README §3-4）。
# MAX_THINKING_TOKENS=32000

# --- コンテキスト・キャッシュ（コストに影響する。チームで揃えるなら README §3-3）---
# アイドル時コンパクションを始めるコンテキスト量（既定 200000・下限 100000）。
# CLAUDE_CODE_IDLE_COMPACT_MIN_TOKENS=300000
# メイン会話のプロンプトキャッシュ TTL（5m か 1h のみ。1h は書き込み単価が高い。v2.1.242 以降）。
# CLAUDE_CODE_PROMPT_CACHE_TTL=1h
# 自動圧縮のウィンドウ（どこまでコンテキストが埋まったら圧縮するか。100000〜1000000 トークン）。
# 接尾辞なしの数値はトークン数そのもの（200 は 200 トークン扱い）。200k / 1M の形は v2.1.304 以降。
# ⚠ 設定すると --autocompact・/autocompact より優先される。原則そちらを使う（README §3-4）
# CLAUDE_CODE_AUTO_COMPACT_WINDOW=200000

# --- サブエージェント ---
# 同時に動かせるサブエージェント数の上限（既定 20。v2.1.217 以降）。
# CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS=10
# fork モード（Claude が会話を引き継いだ分岐 = fork を自分で起動できる）。既定で有効。有効な間、対話セッションでは
# Claude がサブエージェントの完了を待てない（すべて background で動く）。0 で無効にすると、頼めば待つ（README §3-4）。
# CLAUDE_CODE_FORK_SUBAGENT=0
# 上の代わりに 1 にすると、Claude はすべてのサブエージェントの完了を待つ。ただし Bash / PowerShell の background
# 実行・Ctrl+B・forked skill の background 実行も止まる（MCP タスクと Monitor tool は background のまま）。
# CLAUDE_CODE_DISABLE_BACKGROUND_TASKS=1

# --- タイムアウト（環境依存）---
# Bash / PowerShell ツールの foreground コマンドの既定・上限タイムアウト（既定 120000 / 600000）。
# BASH_DEFAULT_TIMEOUT_MS=120000
# BASH_MAX_TIMEOUT_MS=600000
# MCP サーバ起動のタイムアウト（既定 30000）。
# MCP_TIMEOUT=30000
# MCP ツール実行のタイムアウト（既定 100000000 ≒ 28 時間）。HTTP / SSE 系は別に 1 リクエスト 60 秒の
# 上限があり、60000 を超える値を入れるとその上限も引き上がる。60000 以下にすると全体を縮めるだけ。
# MCP_TOOL_TIMEOUT=300000
# API リクエストの各試行がレスポンスヘッダを受け取るまでの待ち時間（既定 600000 = 10 分）。遅い回線や
# プロキシ経由で切れる場合に延ばす。0 で無制限（v2.1.305 以降。細則は README §3-4）。
# API_TIMEOUT_MS=1200000

# --- 空き容量・メモリの警告（環境依存。v2.1.304 以降）---
# 作業ディレクトリのファイルシステムの空きがこの GiB を下回ると、Claude に警告（system reminder）を渡す。
# 未設定・0・数字以外は無効。ここか OS の環境変数で設定する（README §3-4）。
# CLAUDE_CODE_WARN_DISK_FREE_GIB=10
# 同じく利用可能メモリがこの GiB を下回ると警告する（Linux / WSL のみ）。
# CLAUDE_CODE_WARN_MEMORY_FREE_GIB=4

# --- Windows 環境（Windows でのみ意味がある）---
# Git Bash が PATH に無い場合の bash.exe の場所（存在しない・bash でないパスは警告付きで無視される）。
# CLAUDE_CODE_GIT_BASH_PATH=C:\Program Files\Git\bin\bash.exe
# Backspace で単語ごと消えてしまう端末では 0 にする（既定は Windows で Ctrl+Backspace 扱い）。
# CLAUDE_CODE_BS_AS_CTRL_BACKSPACE=0
# PowerShell ツールの有効 / 無効。Git Bash 導入済みの Windows では claude.ai / Console 認証時に既定で有効、
# Bedrock / Agent Platform / Foundry では 1 で有効化する（チームで揃えるなら README §3-3）。
# CLAUDE_CODE_USE_POWERSHELL_TOOL=1

# --- プロキシ（個人環境で必要な場合。チームで揃えるなら README §3-3）---
# ⛔ 認証付きプロキシ（user:pass@ を含む URL）は書かない。OS の環境変数で設定する（README §3-2）。SOCKS は非対応。
# HTTP_PROXY=http://proxy.example.local:8080
# HTTPS_PROXY=http://proxy.example.local:8080
# NO_PROXY=localhost,127.0.0.1
